# Generated by node-limits.sh. Change the values file, not this file.
table inet iota_node_limits {}
delete table inet iota_node_limits
table inet iota_node_limits {
  comment "node-limits 620738958-2085"
  ct timeout handshake_v4 { protocol tcp; l3proto ip; policy = { syn_sent: 10, syn_recv: 10 }; }
  ct timeout handshake_v6 { protocol tcp; l3proto ip6; policy = { syn_sent: 10, syn_recv: 10 }; }
  set logged_v4 { type ipv4_addr; size 65535; flags dynamic,timeout; timeout 2m; }
  set logged_v6 { type ipv6_addr; size 65535; flags dynamic,timeout; timeout 2m; }
  set p8080_v4 { type ipv4_addr; size 65535; flags dynamic; }  # default, 16
  set p8080_v6 { type ipv6_addr; size 65535; flags dynamic; }
  counter p8080_accepted {}
  counter p8080_refused {}
  counter p8080_untracked {}
  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;
    fib daddr type != local return
    tcp flags & (fin|syn|rst|ack) != syn return
    ct state != new return
    tcp dport != { 8080 } return
    meta nfproto ipv4 ct timeout set "handshake_v4"
    meta nfproto ipv6 ct timeout set "handshake_v6"
    tcp dport vmap { 8080 : jump p8080 }
  }
  chain p8080 {
    ip saddr 127.0.0.0/8 counter name p8080_accepted accept
    ip6 saddr ::1 counter name p8080_accepted accept
    add @p8080_v4 { ip saddr ct count over 16 } counter name p8080_refused goto refuse
    add @p8080_v6 { ip6 saddr & ffff:ffff:ffff:ffff:: ct count over 16 } counter name p8080_refused goto refuse
    meta nfproto ipv4 ip saddr != @p8080_v4 counter name p8080_untracked
    meta nfproto ipv6 ip6 saddr & ffff:ffff:ffff:ffff:: != @p8080_v6 counter name p8080_untracked
    counter name p8080_accepted
  }
  chain refuse {
    add @logged_v4 { ip saddr limit rate 1/minute burst 1 packets } limit rate 20/second log prefix "iota-node-limits refused: " level warn goto send_rst
    add @logged_v6 { ip6 saddr & ffff:ffff:ffff:ffff:: limit rate 1/minute burst 1 packets } limit rate 20/second log prefix "iota-node-limits refused: " level warn goto send_rst
    goto send_rst
  }
  chain send_rst {
    reject with tcp reset
  }
}
