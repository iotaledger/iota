# Rules that were tested with a running validator before node-limits.sh was
# written, for the values of node-limits.conf. The generated rules must be
# equal to them after the renames in run.sh.
table inet node_limits {}
delete table inet node_limits
table inet node_limits {
  ct timeout half_open_v4 { protocol tcp; l3proto ip; policy = { syn_sent: 5, syn_recv: 5 }; }
  ct timeout half_open_v6 { protocol tcp; l3proto ip6; policy = { syn_sent: 5, syn_recv: 5 }; }
  set logged_v4 { type ipv4_addr; size 65535; flags dynamic,timeout; timeout 2m; }
  set logged_v6 { type ipv6_addr; size 65535; flags dynamic,timeout; timeout 2m; }
  set p8080_v4 { type ipv4_addr; size 65535; flags dynamic; }  # default, 16
  set p8080_v6 { type ipv6_addr; size 65535; flags dynamic; }
  set p8080_lo_v4 { type ipv4_addr; size 65535; flags dynamic; }  # loopback, 1024
  set p8080_lo_v6 { type ipv6_addr; size 65535; flags dynamic; }
  counter p8080_accepted {}
  counter p8080_refused {}
  counter p8080_untracked {}
  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;
    fib daddr type != local return
    tcp flags & (fin|syn|rst|ack) != syn return
    ct state != new return
    tcp dport != { 8080 } return
    meta nfproto ipv4 ct timeout set "half_open_v4"
    meta nfproto ipv6 ct timeout set "half_open_v6"
    tcp dport vmap { 8080 : jump p8080 }
  }
  chain p8080 {
    ip saddr 127.0.0.0/8 goto p8080_lo
    ip6 saddr ::1 goto p8080_lo
    add @p8080_v4 { ip saddr ct count over 16 } counter name p8080_refused goto refuse
    add @p8080_v6 { ip6 saddr & ffff:ffff:ffff:ffff:: ct count over 16 } counter name p8080_refused goto refuse
    meta nfproto ipv4 ip saddr != @p8080_v4 counter name p8080_untracked
    meta nfproto ipv6 ip6 saddr & ffff:ffff:ffff:ffff:: != @p8080_v6 counter name p8080_untracked
    counter name p8080_accepted
  }
  chain p8080_lo {  # loopback
    add @p8080_lo_v4 { ip saddr ct count over 1024 } counter name p8080_refused goto refuse
    add @p8080_lo_v6 { ip6 saddr & ffff:ffff:ffff:ffff:: ct count over 1024 } counter name p8080_refused goto refuse
    meta nfproto ipv4 ip saddr != @p8080_lo_v4 counter name p8080_untracked
    meta nfproto ipv6 ip6 saddr & ffff:ffff:ffff:ffff:: != @p8080_lo_v6 counter name p8080_untracked
    counter name p8080_accepted
  }
  chain refuse {
    add @logged_v4 { ip saddr limit rate 1/minute burst 1 packets } limit rate 20/second log prefix "node_limits refused: " level warn goto send_rst
    add @logged_v6 { ip6 saddr & ffff:ffff:ffff:ffff:: limit rate 1/minute burst 1 packets } limit rate 20/second log prefix "node_limits refused: " level warn goto send_rst
    goto send_rst
  }
  chain send_rst {
    reject with tcp reset
  }
}
