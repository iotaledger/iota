<mxfile host="drawio" type="device">
  <diagram id="account-query" name="Query: accounts K can unlock">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="p3_0" />
        <mxCell id="p3_1" parent="p3_0" />
        <mxCell id="p3_title" value="Account discoverability: which smart accounts can key K unlock?" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="p3_1">
          <mxGeometry x="40" y="15" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3_legend" value="Same example as the table-filling diagram (A1, A2), after five more transactions. &lt;b&gt;K&lt;/b&gt;, &lt;b&gt;K2&lt;/b&gt; = Ed25519 public keys &amp;nbsp;·&amp;nbsp; &lt;b&gt;h(K)&lt;/b&gt; = blake2b256(0x00 || K) &amp;nbsp;·&amp;nbsp; green = returned and unlockable, yellow = returned but not unlockable, grey = not returned" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="p3_1">
          <mxGeometry x="40" y="45" width="1500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3_history" value="&lt;b&gt;Transactions so far&lt;/b&gt;&lt;br&gt;101: builtin_auth_builder_v1(K), build_v1 → A1&lt;br&gt;102: ClaimAccount with K → A2&lt;br&gt;103: builtin_auth_builder_v1(K), build_v1 → A3&lt;br&gt;104: A3 rotate_auth_function_ref_v1 → a custom authenticator&lt;br&gt;105: builtin_auth_builder_v1(K), build_v1 → A4&lt;br&gt;106: A4 rotate_builtin_auth_public_key: K → K2&lt;br&gt;107: a third-party package calls attach_public_key(O5, K)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;on its own object O5 (not a SmartAccount)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;arcSize=8;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;fillColor=#FFFFFF;" vertex="1" parent="p3_1">
          <mxGeometry x="40" y="80" width="480" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3_s1" value="&lt;b&gt;① Wallet&lt;/b&gt; holds K and sends:&lt;br&gt;iotax_getAccountsByPublicKey(&lt;br&gt;&amp;nbsp;&amp;nbsp;base64(0x00 || K),&amp;nbsp; include_unlinked = false )" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;arcSize=8;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;fillColor=#FFFFFF;" vertex="1" parent="p3_1">
          <mxGeometry x="40" y="280" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3_s2" value="&lt;b&gt;② JSON-RPC server&lt;/b&gt; (indexer) hashes the key, without parsing it:&lt;br&gt;key_id = blake2b256(0x00 || K) = h(K)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;arcSize=8;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;fillColor=#DAE8FC;" vertex="1" parent="p3_1">
          <mxGeometry x="40" y="400" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_s3" value='&lt;b&gt;③ Query&lt;/b&gt; (read.rs get_accounts_by_key_id, as SQL)&lt;br&gt;&lt;font face="Courier New"&gt;SELECT l.*, s.*, a.*&lt;br&gt;FROM account_key_links l&lt;br&gt;LEFT JOIN smart_accounts s&lt;br&gt;&amp;nbsp;&amp;nbsp;ON s.account_id = l.account_id&lt;br&gt;LEFT JOIN account_authenticators a&lt;br&gt;&amp;nbsp;&amp;nbsp;ON a.account_id = l.account_id&lt;br&gt;WHERE l.key_id = h(K)&lt;br&gt;&amp;nbsp;&amp;nbsp;AND l.status = 0&amp;nbsp;&amp;nbsp;-- active only&lt;br&gt;ORDER BY l.last_change_tx_sequence_number DESC&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;arcSize=8;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;fillColor=#FFFFFF;" vertex="1" parent="p3_1">
          <mxGeometry x="40" y="500" width="480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p3_links" value="&lt;b&gt;account_key_links&lt;/b&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;strokeColor=#000000;fontSize=12;collapsible=0;align=left;spacingLeft=10;startSize=30;fillColor=#F5F5F5;swimlaneFillColor=#F5F5F5;" vertex="1" parent="p3_1">
          <mxGeometry x="600" y="80" width="800" height="296" as="geometry" />
        </mxCell>
        <mxCell id="p3_links_hdr" value='&lt;table style="width:100%;table-layout:fixed;font-size:11px;border-collapse:collapse"&gt;&lt;tr&gt;&lt;td style="width:11%;padding:0 4px"&gt;&lt;b&gt;key_id&lt;/b&gt;&lt;/td&gt;&lt;td style="width:12%;padding:0 4px"&gt;&lt;b&gt;account_id&lt;/b&gt;&lt;/td&gt;&lt;td style="width:14%;padding:0 4px"&gt;&lt;b&gt;scheme&lt;/b&gt;&lt;/td&gt;&lt;td style="width:13%;padding:0 4px"&gt;&lt;b&gt;source&lt;/b&gt;&lt;/td&gt;&lt;td style="width:15%;padding:0 4px"&gt;&lt;b&gt;status&lt;/b&gt;&lt;/td&gt;&lt;td style="width:20%;padding:0 4px"&gt;&lt;b&gt;last_change_tx_&lt;br&gt;sequence_number&lt;/b&gt;&lt;/td&gt;&lt;td style="width:15%;padding:0 4px"&gt;&lt;b&gt;last_change_&lt;br&gt;epoch&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;" vertex="1" parent="p3_links">
          <mxGeometry x="10" y="35" width="780" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3_links_r1" value='&lt;table style="width:100%;table-layout:fixed;font-size:11px;border-collapse:collapse"&gt;&lt;tr&gt;&lt;td style="width:11%;padding:0 4px"&gt;h(K)&lt;/td&gt;&lt;td style="width:12%;padding:0 4px"&gt;A1&lt;/td&gt;&lt;td style="width:14%;padding:0 4px"&gt;0 (Ed25519)&lt;/td&gt;&lt;td style="width:13%;padding:0 4px"&gt;0 (attach)&lt;/td&gt;&lt;td style="width:15%;padding:0 4px"&gt;0 (active)&lt;/td&gt;&lt;td style="width:20%;padding:0 4px"&gt;101&lt;/td&gt;&lt;td style="width:15%;padding:0 4px"&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacing=0;fillColor=#D5E8D4;" vertex="1" parent="p3_links">
