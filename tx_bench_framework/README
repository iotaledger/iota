      "package_id": "0x4e5d2501a5db57402abf97824a43680c1e67f94ee3806d0796d4cfded3db072c",
      "package_metadata_object_id": "0xe2bf77960d032e71cafecf35421f40441763b65a36865cb2a36d39014c6852e5",
