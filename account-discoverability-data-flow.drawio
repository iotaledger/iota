<mxfile host="drawio" type="device">
  <diagram id="account-data-flow" name="Data flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Account discoverability: how event data reaches the wallet (PR #12944)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="framework" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Move framework (0x2)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;executed by the network&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;builtin_authenticator_functions&lt;/b&gt;&lt;br&gt;PublicKeyAttached / Detached / Rotated&lt;br&gt;&lt;b&gt;smart_account&lt;/b&gt;&lt;br&gt;SmartAccountCreated (new in this PR)&lt;br&gt;&lt;b&gt;account&lt;/b&gt; (SmartAccount only)&lt;br&gt;Mutable/ImmutableAccountCreated&lt;br&gt;AuthenticatorFunctionRefV1Rotated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="230" height="190" as="geometry" />
        </mxCell>

        <mxCell id="fullnode" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Fullnode&lt;/b&gt;&lt;/font&gt;&lt;br&gt;stores checkpointed transactions&lt;br&gt;and their events&lt;br&gt;serves checkpoint data&lt;br&gt;and iota_subscribeEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;arcSize=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="130" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="indexer" value="iota-indexer" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#F5F5F5;swimlaneFillColor=#F5F5F5;strokeColor=#000000;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="660" y="70" width="280" height="520" as="geometry" />
        </mxCell>
        <mxCell id="ingestion" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Ingestion&lt;/b&gt;&lt;/font&gt;&lt;br&gt;index_transactions (prepare.rs):&lt;br&gt;checkpointed transactions only&lt;br&gt;events to rows (account_key_events.rs)&lt;br&gt;last write per key in each batch&lt;br&gt;(persist.rs)&lt;br&gt;upsert only if the tx is not older&lt;br&gt;(pg_indexer_store.rs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;arcSize=10;fontSize=11;" vertex="1" parent="indexer">
          <mxGeometry x="15" y="45" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rpc" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;JSON-RPC server&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;iotax_getAccountsByPublicKey&lt;/b&gt;&lt;br&gt;key_id = blake2b256(flag || raw key)&lt;br&gt;get_accounts_by_key_id (read.rs)&lt;br&gt;active links only, unless include_unlinked&lt;br&gt;newest change first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#000000;arcSize=10;fontSize=11;" vertex="1" parent="indexer">
          <mxGeometry x="15" y="340" width="250" height="150" as="geometry" />
        </mxCell>

        <mxCell id="postgres" value="PostgreSQL" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#F5F5F5;swimlaneFillColor=#F5F5F5;strokeColor=#000000;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1050" y="70" width="220" height="520" as="geometry" />
        </mxCell>
        <mxCell id="t_links" value="&lt;b&gt;account_key_links&lt;/b&gt;&lt;br&gt;key: (key_id, account_id)&lt;br&gt;status, source, scheme&lt;br&gt;written from&lt;br&gt;PublicKey* events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;arcSize=10;fontSize=11;" vertex="1" parent="postgres">
          <mxGeometry x="15" y="45" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="t_accounts" value="&lt;b&gt;smart_accounts&lt;/b&gt;&lt;br&gt;key: account_id&lt;br&gt;immutable&lt;br&gt;written from&lt;br&gt;SmartAccountCreated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;arcSize=10;fontSize=11;" vertex="1" parent="postgres">
          <mxGeometry x="15" y="185" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="t_auth" value="&lt;b&gt;account_authenticators&lt;/b&gt;&lt;br&gt;key: account_id&lt;br&gt;kind: 5 built-in, or custom&lt;br&gt;written from&lt;br&gt;iota::account events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;arcSize=10;fontSize=11;" vertex="1" parent="postgres">
          <mxGeometry x="15" y="325" width="190" height="110" as="geometry" />
        </mxCell>

        <mxCell id="wallet" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Wallet / SDK&lt;/b&gt;&lt;/font&gt;&lt;br&gt;derives keys from the seed&lt;br&gt;one query per key&lt;br&gt;keeps: active, smartAccount,&lt;br&gt;built-in authenticator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;arcSize=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="250" height="130" as="geometry" />
        </mxCell>

        <mxCell id="upsert_note" value="rows (upsert)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="945" y="95" width="100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e_events" value="events in&lt;br&gt;transaction effects" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="framework" target="fullnode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_checkpoints" value="checkpoint data&lt;br&gt;(txs + events)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.467;" edge="1" parent="1" source="fullnode" target="ingestion">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_links" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="ingestion" target="t_links">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1015" y="152" />
              <mxPoint x="1015" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_accounts" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ingestion" target="t_accounts">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="990" y="190" />
              <mxPoint x="990" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_auth" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="ingestion" target="t_auth">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="965" y="227" />
              <mxPoint x="965" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_read" value="rows for one key_id&lt;br&gt;(left join)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=0;exitY=0.9135;entryX=1;entryY=0.9;" edge="1" parent="1" source="postgres" target="rpc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_request" value="request: flag || public key (Base64),&lt;br&gt;include_unlinked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.3077;entryX=0;entryY=0.4;" edge="1" parent="1" source="wallet" target="rpc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_response" value="AccountKeyLink[]: address, status, source,&lt;br&gt;smartAccount, authenticator, scheme,&lt;br&gt;lastChangeEpoch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=0;exitY=0.7667;entryX=1;entryY=0.7308;" edge="1" parent="1" source="rpc" target="wallet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_subscribe" value="optional live updates:&lt;br&gt;iota_subscribeEvent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;labelBackgroundColor=#FFFFFF;fontSize=11;dashed=1;exitX=0.9;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="wallet" target="fullnode">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="265" y="340" />
              <mxPoint x="470" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
