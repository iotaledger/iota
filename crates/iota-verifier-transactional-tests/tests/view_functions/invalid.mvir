// View function attributes can be injected into MVIR tests with
// --view-functions so the bytecode verifier sees the same metadata produced
// by source #[view] attributes.

// These cases mirror the bytecode-visible invalid signatures in:
// external-crates/move/crates/move-compiler/tests/iota_mode/move_2024/typing/view_function/invalid.move

// The invalid source fixture also rejects `mut value: T` parameter bindings.
// That mutability is not encoded in bytecode/MVIR function signatures, so it
// cannot be reproduced as an IOTA bytecode verifier failure.
// The source fixtures' native view functions are represented with regular
// aborting bodies here because arbitrary native functions fail publication
// before the IOTA metadata verifier runs.

//# publish --view-functions private_view
module 0x0.m {
    private_view(): u64 {
        label l0:
        abort 0;
    }
}

//# publish --view-functions no_return
module 0x0.m {
    public no_return() {
        label l0:
        return;
    }
}

