  # Iota keystore tool
  export extern "iota help keytool" [
  ]

  # Update an old alias to a new one. If a new alias is not provided, a random one will be generated
  export extern "iota help keytool update-alias" [
  ]

  # Convert private key in Hex or Base64 to new format (Bech32 encoded 33 byte flag || private key starting with "iotaprivkey"). Hex private key format import and export are both deprecated in Iota Wallet and Iota CLI Keystore. Use `iota keytool import` if you wish to import a key to Iota Keystore
  export extern "iota help keytool convert" [
  ]

  # Given a Base64 encoded transaction bytes, decode its components. If a signature is provided, verify the signature against the transaction and output the result
  export extern "iota help keytool decode-or-verify-tx" [
  ]

  # Given a Base64 encoded MultiSig signature, decode its components. If tx_bytes is passed in, verify the multisig
  export extern "iota help keytool decode-multi-sig" [
  ]

  # Generate a new keypair with key scheme flag {ed25519 | secp256k1 | secp256r1} with optional derivation path, default to m/44'/4218'/0'/0'/0' for ed25519 or m/54'/4218'/0'/0/0 for secp256k1 or m/74'/4218'/0'/0/0 for secp256r1. Word length can be { word12 | word15 | word18 | word21 | word24} default to word12 if not specified
  export extern "iota help keytool generate" [
  ]

  # Add a new key to Iota CLI Keystore using either the input mnemonic phrase, a Bech32 encoded 33-byte `flag || privkey` starting with "iotaprivkey" or a seed, the key scheme flag {ed25519 | secp256k1 | secp256r1} and an optional derivation path, default to m/44'/4218'/0'/0'/0' for ed25519 or m/54'/4218'/0'/0/0 for secp256k1 or m/74'/4218'/0'/0/0 for secp256r1. Supports mnemonic phrase of word length 12, 15, 18, 21, 24. Set an alias for the key with the --alias flag. If no alias is provided, the tool will automatically generate one
  export extern "iota help keytool import" [
  ]

  # Output the private key of the given key identity in Iota CLI Keystore as Bech32 encoded string starting with `iotaprivkey`
  export extern "iota help keytool export" [
  ]

  # List all keys by its Iota address, Base64 encoded public key, key scheme name in iota.keystore
  export extern "iota help keytool list" [
  ]

  # To MultiSig Iota Address. Pass in a list of all public keys `flag || pk` in Base64. See `keytool list` for example public keys
  export extern "iota help keytool multi-sig-address" [
  ]

  # Provides a list of participating signatures (`flag || sig || pk` encoded in Base64), threshold, a list of all public keys and a list of their weights that define the MultiSig address. Returns a valid MultiSig signature and its sender address. The result can be used as signature field for `iota client execute-signed-tx`. The sum of weights of all signatures must be >= the threshold
  export extern "iota help keytool multi-sig-combine-partial-sig" [
  ]

  # Read the content at the provided file path. The accepted format can be [enum IotaKeyPair] (Base64 encoded of 33-byte `flag || privkey`) or `type AuthorityKeyPair` (Base64 encoded `privkey`). It prints its Base64 encoded public key and the key scheme flag
  export extern "iota help keytool show" [
  ]

  # Create signature using the private key for for the given address (or its alias) in iota keystore. Any signature commits to a [struct IntentMessage] consisting of the Base64 encoded of the BCS serialized transaction bytes itself and its intent. If intent is absent, default will be used
  export extern "iota help keytool sign" [
  ]

  # Creates a signature by leveraging AWS KMS. Pass in a key-id to leverage Amazon KMS to sign a message and the base64 pubkey. Generate PubKey from pem using iotaledger/base64pemkey Any signature commits to a [struct IntentMessage] consisting of the Base64 encoded of the BCS serialized transaction bytes itself and its intent. If intent is absent, default will be used
  export extern "iota help keytool sign-kms" [
  ]

