  # Run the bytecode verifier on the package
  export extern "iota client verify-bytecode-meter" [
    --package: string         # Path to directory containing a Move package, (defaults to the current directory)
    --protocol-version: string # Protocol version to use for the bytecode verifier (defaults to the latest protocol version)
    --module: string          # Paths to specific pre-compiled module bytecode to verify (instead of an entire package). Multiple modules can be verified by passing multiple --module flags. They will be treated as if they were one package (subject to the overall package limit)
    --dev(-d)                 # Compile in 'dev' mode. The 'dev-addresses' and 'dev-dependencies' fields will be used if this flag is set. This flag is useful for development of packages that expose named addresses that are not set to a specific value
    --test                    # Compile in 'test' mode. The 'dev-addresses' and 'dev-dependencies' fields will be used along with any code in the 'tests' directory
    --doc                     # Generate documentation for packages
    --install-dir: string     # Installation directory for compiled artifacts. Defaults to current directory
    --force                   # Force recompilation of all packages
    --fetch-deps-only         # Only fetch dependency repos to MOVE_HOME
    --skip-fetch-latest-git-deps # Skip fetching latest git dependencies
    --default-move-flavor: string # Default flavor for move compilation, if not specified in the package's config
    --default-move-edition: string # Default edition for move compilation, if not specified in the package's config
    --dependencies-are-root   # If set, dependency packages are treated as root packages. Notably, this will remove warning suppression in dependency packages
    --silence-warnings        # If set, ignore any compiler warnings
    --warnings-are-errors     # If set, warnings become errors
    --json-errors             # If set, reports errors at JSON
    --no-lint                 # If `true`, disable linters
    --lint                    # If `true`, enables extra linters
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Verify local Move packages against on-chain packages, and optionally their dependencies
  export extern "iota client verify-source" [
    package_path?: string     # Path to directory containing a Move package
    --dev(-d)                 # Compile in 'dev' mode. The 'dev-addresses' and 'dev-dependencies' fields will be used if this flag is set. This flag is useful for development of packages that expose named addresses that are not set to a specific value
    --test                    # Compile in 'test' mode. The 'dev-addresses' and 'dev-dependencies' fields will be used along with any code in the 'tests' directory
    --doc                     # Generate documentation for packages
    --install-dir: string     # Installation directory for compiled artifacts. Defaults to current directory
    --force                   # Force recompilation of all packages
    --fetch-deps-only         # Only fetch dependency repos to MOVE_HOME
    --skip-fetch-latest-git-deps # Skip fetching latest git dependencies
    --default-move-flavor: string # Default flavor for move compilation, if not specified in the package's config
    --default-move-edition: string # Default edition for move compilation, if not specified in the package's config
    --dependencies-are-root   # If set, dependency packages are treated as root packages. Notably, this will remove warning suppression in dependency packages
    --silence-warnings        # If set, ignore any compiler warnings
    --warnings-are-errors     # If set, warnings become errors
    --json-errors             # If set, reports errors at JSON
    --no-lint                 # If `true`, disable linters
    --lint                    # If `true`, enables extra linters
    --verify-deps             # Verify on-chain dependencies
    --skip-source             # Don't verify source (only valid if --verify-deps is enabled)
    --address-override: string # If specified, override the addresses for the package's own modules with this address. Only works for unpublished modules (whose addresses are currently 0x0)
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Profile the gas usage of a transaction. Unless an output filepath is not specified, outputs a file `gas_profile_{tx_digest}_{unix_timestamp}.json` which can be opened in a flamegraph tool such as speedscope
  export extern "iota client profile-transaction" [
    --tx-digest(-t): string   # The digest of the transaction to replay
    --profile-output(-p): string # If specified, overrides the filepath of the output profile, for example -- /temp/my_profile_name.json will write output to `/temp/my_profile_name_{tx_digest}_{unix_timestamp}.json` If an output filepath is not specified, it will output a file `gas_profile_{tx_digest}_{unix_timestamp}.json` to the working directory
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Replay a given transaction to view transaction effects. Set environment variable MOVE_VM_STEP=1 to debug
  export extern "iota client replay-transaction" [
    --tx-digest(-t): string   # The digest of the transaction to replay
    --gas-info                # Log extra gas-related information
    --ptb-info                # Log information about each programmable transaction command
    --executor-version(-e): string # Optional version of the executor to use, if not specified defaults to the one originally used for the transaction
    --protocol-version(-p): string # Optional protocol version to use, if not specified defaults to the one originally used for the transaction
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

