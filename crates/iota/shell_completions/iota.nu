module completions {

  export extern iota [
    --help(-h)                # Print help
  ]

  # Start a local network in two modes: saving state between re-runs and not saving state between re-runs. Please use (--help) to see the full description
  export extern "iota start" [
    --network.config: string  # Config directory that will be used to store network config, node db, keystore. `iota genesis -f --with-faucet` generates a genesis config that can be used to start this process. Use with caution as the `-f` flag will overwrite the existing config directory. We can use any config dir that is generated by the `iota genesis`
    --force-regenesis         # A new genesis is created each time this flag is set, and state is not persisted between runs. Only use this flag when you want to start the network from scratch every time you run this command
    --with-faucet: string     # Start a faucet with default host and port: 0.0.0.0:9123. This flag accepts also a port, a host, or both (e.g., 0.0.0.0:9123). When providing a specific value, please use the = sign between the flag and value: `--with-faucet=6124` or `--with-faucet=0.0.0.0`, or `--with-faucet=0.0.0.0:9123`
    --faucet-amount: string   # Set the amount of nanos that the faucet will put in an object. Defaults to `200000000000`(200 IOTA)
    --fullnode-rpc-port: string # Port to start the Fullnode RPC server on. Default port is 9000
    --epoch-duration-ms: string # Set the epoch duration. Can only be used when `--force-regenesis` flag is passed or if there's no genesis config and one will be auto-generated. When this flag is not set but `--force-regenesis` is set, the epoch duration will be set to 60 seconds
    --no-full-node            # Start the network without a fullnode
    --local-migration-snapshots: string # The path to local migration snapshot files
    --remote-migration-snapshots: string # Remotely stored migration snapshots
    --help(-h)                # Print help (see more with '--help')
  ]

  # Bootstrap and initialize a new iota network
  export extern "iota genesis" [
    --from-config: string     # Start genesis with a given config file
    --write-config: string    # Build a genesis config, write it to the specified path, and exit
    --working-dir: string
    --force(-f)               # Forces overwriting existing configuration
    --epoch-duration-ms: string
    --benchmark-ips: string   # A list of ip addresses to generate a genesis suitable for benchmarks
    --with-faucet             # Creates an extra faucet configuration for iota persisted runs.
    --num-validators: string  # The number of validators in the network.
    --local-migration-snapshots: string # The path to local migration snapshot files
    --remote-migration-snapshots: string # Remotely stored migration snapshots
    --help(-h)                # Print help
  ]

  # Create an IOTA Genesis Ceremony with multiple remote validators
  export extern "iota genesis-ceremony" [
    --path: string            # The directory where the Genesis builder will be stored. Defaults to the current directory
    --protocol-version: string # The protocol version to use for this snapshot
    --help(-h)                # Print help
  ]

  # Initialize a Genesis builder which can be configured with validators
  export extern "iota genesis-ceremony init" [
    --help(-h)                # Print help
  ]

  # Validate the current state of the Genesis builder
  export extern "iota genesis-ceremony validate-state" [
    --help(-h)                # Print help
  ]

  # Add a validator to the Genesis builder
  export extern "iota genesis-ceremony add-validator" [
    --name: string            # The name of the validator
    --authority-key-file: string # The path to the BLS12381 authority key file for the validator
    --protocol-key-file: string # The path to the Ed25519 network key file for the consensus protocol
    --account-key-file: string # The path to the Ed25519 network key file for the account
    --network-key-file: string # The path to the Ed25519 network key file
    --network-address: string # The network address. This must be a TCP address in ASCII format
    --p2p-address: string     # The peer-to-peer address. This must be a UDP address in ASCII format
    --primary-address: string # The primary address. This must be a UDP address in ASCII format
    --description: string     # An optional description of the validator
    --image-url: string       # An optional URL pointing to an image for the validator
    --project-url: string     # An optional URL pointing to the validator webpage
    --help(-h)                # Print help
  ]

  # Initialize token distribution schedule
  export extern "iota genesis-ceremony init-token-distribution-schedule" [
    --token-allocations-path: string # The path to the csv file with the token allocations
    --help(-h)                # Print help
  ]

  # List the current validators in the Genesis builder
  export extern "iota genesis-ceremony list-validators" [
    --help(-h)                # Print help
  ]

  # Build the Genesis checkpoint
  export extern "iota genesis-ceremony build-unsigned-checkpoint" [
    --local-migration-snapshots: string # Define paths to local migration snapshots.
    --remote-migration-snapshots: string # Remote migration snapshots.
    --help(-h)                # Print help
  ]

  # Examine the details of the built Genesis checkpoint
  export extern "iota genesis-ceremony examine-genesis-checkpoint" [
    --help(-h)                # Print help
  ]

  # Verify and sign the built Genesis checkpoint
  export extern "iota genesis-ceremony verify-and-sign" [
    --key-file: string        # The path to a key file which will be used to sign the checkpoint
    --help(-h)                # Print help
  ]

  # Create the Genesis blob file from the current configuration
  export extern "iota genesis-ceremony finalize" [
    --help(-h)                # Print help
  ]

  # Print this message or the help of the given subcommand(s)
  export extern "iota genesis-ceremony help" [
  ]

  # Initialize a Genesis builder which can be configured with validators
  export extern "iota genesis-ceremony help init" [
  ]

  # Validate the current state of the Genesis builder
  export extern "iota genesis-ceremony help validate-state" [
  ]

  # Add a validator to the Genesis builder
  export extern "iota genesis-ceremony help add-validator" [
  ]

  # Initialize token distribution schedule
  export extern "iota genesis-ceremony help init-token-distribution-schedule" [
  ]

  # List the current validators in the Genesis builder
  export extern "iota genesis-ceremony help list-validators" [
  ]

  # Build the Genesis checkpoint
  export extern "iota genesis-ceremony help build-unsigned-checkpoint" [
  ]

  # Examine the details of the built Genesis checkpoint
  export extern "iota genesis-ceremony help examine-genesis-checkpoint" [
  ]

  # Verify and sign the built Genesis checkpoint
  export extern "iota genesis-ceremony help verify-and-sign" [
  ]

  # Create the Genesis blob file from the current configuration
  export extern "iota genesis-ceremony help finalize" [
  ]

  # Print this message or the help of the given subcommand(s)
  export extern "iota genesis-ceremony help help" [
  ]

  # Iota keystore tool
  export extern "iota keytool" [
    --keystore-path: string
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Update an old alias to a new one. If a new alias is not provided, a random one will be generated
  export extern "iota keytool update-alias" [
    old_alias: string
    new_alias?: string        # The alias must start with a letter and can contain only letters, digits, dots, hyphens (-), or underscores (_)
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Convert private key in Hex or Base64 to new format (Bech32 encoded 33 byte flag || private key starting with "iotaprivkey"). Hex private key format import and export are both deprecated in Iota Wallet and Iota CLI Keystore. Use `iota keytool import` if you wish to import a key to Iota Keystore
  export extern "iota keytool convert" [
    value: string
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Given a Base64 encoded transaction bytes, decode its components. If a signature is provided, verify the signature against the transaction and output the result
  export extern "iota keytool decode-or-verify-tx" [
    --tx-bytes: string
    --sig: string
    --cur-epoch: string
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Given a Base64 encoded MultiSig signature, decode its components. If tx_bytes is passed in, verify the multisig
  export extern "iota keytool decode-multi-sig" [
    --multisig: string
    --tx-bytes: string
    --cur-epoch: string
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Generate a new keypair with key scheme flag {ed25519 | secp256k1 | secp256r1} with optional derivation path, default to m/44'/4218'/0'/0'/0' for ed25519 or m/54'/4218'/0'/0/0 for secp256k1 or m/74'/4218'/0'/0/0 for secp256r1. Word length can be { word12 | word15 | word18 | word21 | word24} default to word12 if not specified
  export extern "iota keytool generate" [
    key_scheme: string
    derivation_path?: string
    word_length?: string
    --json                    # Return command outputs in json format
    --help(-h)                # Print help (see more with '--help')
  ]

  # Add a new key to Iota CLI Keystore using either the input mnemonic phrase, a Bech32 encoded 33-byte `flag || privkey` starting with "iotaprivkey" or a seed, the key scheme flag {ed25519 | secp256k1 | secp256r1} and an optional derivation path, default to m/44'/4218'/0'/0'/0' for ed25519 or m/54'/4218'/0'/0/0 for secp256k1 or m/74'/4218'/0'/0/0 for secp256r1. Supports mnemonic phrase of word length 12, 15, 18, 21, 24. Set an alias for the key with the --alias flag. If no alias is provided, the tool will automatically generate one
  export extern "iota keytool import" [
    --alias: string           # Sets an alias for this address. The alias must start with a letter and can contain only letters, digits, hyphens (-), or underscores (_)
    input_string: string
    key_scheme: string
    derivation_path?: string
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Output the private key of the given key identity in Iota CLI Keystore as Bech32 encoded string starting with `iotaprivkey`
  export extern "iota keytool export" [
    --key-identity: string
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # List all keys by its Iota address, Base64 encoded public key, key scheme name in iota.keystore
  export extern "iota keytool list" [
    --sort-by-alias(-s)       # Sort by alias
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # To MultiSig Iota Address. Pass in a list of all public keys `flag || pk` in Base64. See `keytool list` for example public keys
  export extern "iota keytool multi-sig-address" [
    --threshold: string
    --pks: string
    --weights: string
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Provides a list of participating signatures (`flag || sig || pk` encoded in Base64), threshold, a list of all public keys and a list of their weights that define the MultiSig address. Returns a valid MultiSig signature and its sender address. The result can be used as signature field for `iota client execute-signed-tx`. The sum of weights of all signatures must be >= the threshold
  export extern "iota keytool multi-sig-combine-partial-sig" [
    --sigs: string
    --pks: string
    --weights: string
    --threshold: string
    --json                    # Return command outputs in json format
    --help(-h)                # Print help (see more with '--help')
  ]

  # Read the content at the provided file path. The accepted format can be [enum IotaKeyPair] (Base64 encoded of 33-byte `flag || privkey`) or `type AuthorityKeyPair` (Base64 encoded `privkey`). It prints its Base64 encoded public key and the key scheme flag
  export extern "iota keytool show" [
    file: string
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Create signature using the private key for for the given address (or its alias) in iota keystore. Any signature commits to a [struct IntentMessage] consisting of the Base64 encoded of the BCS serialized transaction bytes itself and its intent. If intent is absent, default will be used
  export extern "iota keytool sign" [
    --address: string
    --data: string
    --intent: string
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Creates a signature by leveraging AWS KMS. Pass in a key-id to leverage Amazon KMS to sign a message and the base64 pubkey. Generate PubKey from pem using iotaledger/base64pemkey Any signature commits to a [struct IntentMessage] consisting of the Base64 encoded of the BCS serialized transaction bytes itself and its intent. If intent is absent, default will be used
  export extern "iota keytool sign-kms" [
    --data: string
    --keyid: string
    --intent: string
    --base64pk: string
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Print this message or the help of the given subcommand(s)
  export extern "iota keytool help" [
  ]

  # Update an old alias to a new one. If a new alias is not provided, a random one will be generated
  export extern "iota keytool help update-alias" [
  ]

  # Convert private key in Hex or Base64 to new format (Bech32 encoded 33 byte flag || private key starting with "iotaprivkey"). Hex private key format import and export are both deprecated in Iota Wallet and Iota CLI Keystore. Use `iota keytool import` if you wish to import a key to Iota Keystore
  export extern "iota keytool help convert" [
  ]

  # Given a Base64 encoded transaction bytes, decode its components. If a signature is provided, verify the signature against the transaction and output the result
  export extern "iota keytool help decode-or-verify-tx" [
  ]

  # Given a Base64 encoded MultiSig signature, decode its components. If tx_bytes is passed in, verify the multisig
  export extern "iota keytool help decode-multi-sig" [
  ]

  # Generate a new keypair with key scheme flag {ed25519 | secp256k1 | secp256r1} with optional derivation path, default to m/44'/4218'/0'/0'/0' for ed25519 or m/54'/4218'/0'/0/0 for secp256k1 or m/74'/4218'/0'/0/0 for secp256r1. Word length can be { word12 | word15 | word18 | word21 | word24} default to word12 if not specified
  export extern "iota keytool help generate" [
  ]

  # Add a new key to Iota CLI Keystore using either the input mnemonic phrase, a Bech32 encoded 33-byte `flag || privkey` starting with "iotaprivkey" or a seed, the key scheme flag {ed25519 | secp256k1 | secp256r1} and an optional derivation path, default to m/44'/4218'/0'/0'/0' for ed25519 or m/54'/4218'/0'/0/0 for secp256k1 or m/74'/4218'/0'/0/0 for secp256r1. Supports mnemonic phrase of word length 12, 15, 18, 21, 24. Set an alias for the key with the --alias flag. If no alias is provided, the tool will automatically generate one
  export extern "iota keytool help import" [
  ]

  # Output the private key of the given key identity in Iota CLI Keystore as Bech32 encoded string starting with `iotaprivkey`
  export extern "iota keytool help export" [
  ]

  # List all keys by its Iota address, Base64 encoded public key, key scheme name in iota.keystore
  export extern "iota keytool help list" [
  ]

  # To MultiSig Iota Address. Pass in a list of all public keys `flag || pk` in Base64. See `keytool list` for example public keys
  export extern "iota keytool help multi-sig-address" [
  ]

  # Provides a list of participating signatures (`flag || sig || pk` encoded in Base64), threshold, a list of all public keys and a list of their weights that define the MultiSig address. Returns a valid MultiSig signature and its sender address. The result can be used as signature field for `iota client execute-signed-tx`. The sum of weights of all signatures must be >= the threshold
  export extern "iota keytool help multi-sig-combine-partial-sig" [
  ]

  # Read the content at the provided file path. The accepted format can be [enum IotaKeyPair] (Base64 encoded of 33-byte `flag || privkey`) or `type AuthorityKeyPair` (Base64 encoded `privkey`). It prints its Base64 encoded public key and the key scheme flag
  export extern "iota keytool help show" [
  ]

  # Create signature using the private key for for the given address (or its alias) in iota keystore. Any signature commits to a [struct IntentMessage] consisting of the Base64 encoded of the BCS serialized transaction bytes itself and its intent. If intent is absent, default will be used
  export extern "iota keytool help sign" [
  ]

  # Creates a signature by leveraging AWS KMS. Pass in a key-id to leverage Amazon KMS to sign a message and the base64 pubkey. Generate PubKey from pem using iotaledger/base64pemkey Any signature commits to a [struct IntentMessage] consisting of the Base64 encoded of the BCS serialized transaction bytes itself and its intent. If intent is absent, default will be used
  export extern "iota keytool help sign-kms" [
  ]

  # Print this message or the help of the given subcommand(s)
  export extern "iota keytool help help" [
  ]

  # Start Iota interactive console
  export extern "iota console" [
    --client.config: string   # Sets the file storing the state of our user accounts (an empty one will be created if missing)
    --help(-h)                # Print help
  ]

  # Client for interacting with the IOTA network
  export extern "iota client" [
    --client.config: string   # Sets the file storing the state of our user accounts (an empty one will be created if missing)
    --json                    # Return command outputs in json format
    --yes(-y)
    --help(-h)                # Print help
  ]

  # Default address used for commands when none specified
  export extern "iota client active-address" [
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Default environment used for commands when none specified
  export extern "iota client active-env" [
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Obtain the Addresses managed by the client
  export extern "iota client addresses" [
    --sort-by-alias(-s)       # Sort by alias instead of address
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # List the coin balance of an address
  export extern "iota client balance" [
    address?: string          # Address (or its alias)
    --coin-type: string       # Show balance for the specified coin (e.g., 0x2::iota::IOTA). All coins will be shown if none is passed
    --with-coins              # Show a list with each coin's object ID and balance
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Call Move function
  export extern "iota client call" [
    --package: string         # Object ID of the package, which contains the module
    --module: string          # The name of the module in the package
    --function: string        # Function name in module
    --type-args: string       # Type arguments to the generic function being called. All must be specified, or the call will fail
    --args: string            # Simplified ordered args like in the function syntax ObjectIDs, Addresses must be hex strings
    gas_price?: string        # Optional gas price for this call. Currently use only for testing and not in production environments
    --gas: string             # ID of the gas object for gas payment. If not provided, a gas object with at least gas_budget value will be selected
    --gas-budget: string      # An optional gas budget for this transaction (in NANOS). If gas budget is not provided, the tool will first perform a dry run to estimate the gas cost, and then it will execute the transaction. Please note that this incurs a small cost in performance due to the additional dry run call
    --dry-run                 # Perform a dry run of the transaction, without executing it
    --serialize-unsigned-transaction # Instead of executing the transaction, serialize the bcs bytes of the unsigned transaction data (TransactionData) using base64 encoding, and print out the string <TX_BYTES>. The string can be used to execute transaction with `iota client execute-signed-tx --tx-bytes <TX_BYTES>`
    --serialize-signed-transaction # Instead of executing the transaction, serialize the bcs bytes of the signed transaction data (SenderSignedData) using base64 encoding, and print out the string <SIGNED_TX_BYTES>. The string can be used to execute transaction with `iota client execute-combined-signed-tx --signed-tx-bytes <SIGNED_TX_BYTES>`
    --emit: string            # Select which fields of the response to display. If not provided, all fields are displayed. The fields are: effects, input, events, object_changes, balance_changes
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Query the chain identifier from the rpc endpoint
  export extern "iota client chain-identifier" [
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Query a dynamic field by its address
  export extern "iota client dynamic-field" [
    object_id: string         # The ID of the parent object
    --cursor: string          # Optional paging cursor
    --limit: string           # Maximum item returned per page
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # List all IOTA environments
  export extern "iota client envs" [
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Execute a Signed Transaction. This is useful when the user prefers to sign elsewhere and use this command to execute
  export extern "iota client execute-signed-tx" [
    --tx-bytes: string        # BCS serialized transaction data bytes without its type tag, as base64 encoded string. This is the output of iota client command using --serialize-unsigned-transaction
    --signatures: string      # A list of Base64 encoded signatures `flag || signature || pubkey`
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Execute a combined serialized SenderSignedData string
  export extern "iota client execute-combined-signed-tx" [
    --signed-tx-bytes: string # BCS serialized sender signed data, as base64 encoded string. This is the output of iota client command using --serialize-signed-transaction
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Request gas coin from faucet. By default, it will use the active address and the active network
  export extern "iota client faucet" [
    --address: string         # Address (or its alias)
    --url: string             # The url to the faucet
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Obtain all gas objects owned by the address. An address' alias can be used instead of the address
  export extern "iota client gas" [
    owner_address?: string    # Address (or its alias) owning the objects
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Merge two coin objects into one coin
  export extern "iota client merge-coin" [
    --primary-coin: string    # The address of the coin to merge into
    --coin-to-merge: string   # The address of the coin to be merged
    --gas: string             # ID of the gas object for gas payment. If not provided, a gas object with at least gas_budget value will be selected
    --gas-budget: string      # An optional gas budget for this transaction (in NANOS). If gas budget is not provided, the tool will first perform a dry run to estimate the gas cost, and then it will execute the transaction. Please note that this incurs a small cost in performance due to the additional dry run call
    --dry-run                 # Perform a dry run of the transaction, without executing it
    --serialize-unsigned-transaction # Instead of executing the transaction, serialize the bcs bytes of the unsigned transaction data (TransactionData) using base64 encoding, and print out the string <TX_BYTES>. The string can be used to execute transaction with `iota client execute-signed-tx --tx-bytes <TX_BYTES>`
    --serialize-signed-transaction # Instead of executing the transaction, serialize the bcs bytes of the signed transaction data (SenderSignedData) using base64 encoding, and print out the string <SIGNED_TX_BYTES>. The string can be used to execute transaction with `iota client execute-combined-signed-tx --signed-tx-bytes <SIGNED_TX_BYTES>`
    --emit: string            # Select which fields of the response to display. If not provided, all fields are displayed. The fields are: effects, input, events, object_changes, balance_changes
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Generate new address and keypair with keypair scheme flag {ed25519 | secp256k1 | secp256r1} with optional derivation path, default to m/44'/4218'/0'/0'/0' for ed25519 or m/54'/4218'/0'/0/0 for secp256k1 or m/74'/4218'/0'/0/0 for secp256r1. Word length can be { word12 | word15 | word18 | word21 | word24} default to word12 if not specified
  export extern "iota client new-address" [
    key_scheme: string
    alias?: string            # The alias must start with a letter and can contain only letters, digits, hyphens (-), or underscores (_)
    word_length?: string
    derivation_path?: string
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Add new IOTA environment
  export extern "iota client new-env" [
    --alias: string           # The alias for the environment
    --rpc: string             # The RPC Url, for example http://127.0.0.1:9000
    --ws: string              # Optional WebSocket Url, for example ws://127.0.0.1:9000
    --basic-auth: string      # Basic auth in the format of username:password
    --faucet: string          # Optional faucet Url, for example http://127.0.0.1:9123/v1/gas
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Get object info
  export extern "iota client object" [
    object_id: string         # Object ID of the object to fetch
    --bcs                     # Return the bcs serialized version of the object
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Obtain all objects owned by the address. It also accepts an address by its alias
  export extern "iota client objects" [
    owner_address?: string    # Address owning the object. If no address is provided, it will show all objects owned by `iota client active-address`
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Pay coins to recipients following specified amounts, with input coins. Length of recipients must be the same as that of amounts
  export extern "iota client pay" [
    --input-coins: string     # The input coins to be used for pay recipients, following the specified amounts
    --recipients: string      # The recipient addresses, must be of same length as amounts. Aliases of addresses are also accepted as input
    --amounts: string         # The amounts to be paid, following the order of recipients
    --gas: string             # ID of the gas object for gas payment. If not provided, a gas object with at least gas_budget value will be selected
    --gas-budget: string      # An optional gas budget for this transaction (in NANOS). If gas budget is not provided, the tool will first perform a dry run to estimate the gas cost, and then it will execute the transaction. Please note that this incurs a small cost in performance due to the additional dry run call
    --dry-run                 # Perform a dry run of the transaction, without executing it
    --serialize-unsigned-transaction # Instead of executing the transaction, serialize the bcs bytes of the unsigned transaction data (TransactionData) using base64 encoding, and print out the string <TX_BYTES>. The string can be used to execute transaction with `iota client execute-signed-tx --tx-bytes <TX_BYTES>`
    --serialize-signed-transaction # Instead of executing the transaction, serialize the bcs bytes of the signed transaction data (SenderSignedData) using base64 encoding, and print out the string <SIGNED_TX_BYTES>. The string can be used to execute transaction with `iota client execute-combined-signed-tx --signed-tx-bytes <SIGNED_TX_BYTES>`
    --emit: string            # Select which fields of the response to display. If not provided, all fields are displayed. The fields are: effects, input, events, object_changes, balance_changes
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Pay all residual IOTA coins to the recipient with input coins, after deducting the gas cost. The input coins also include the coin for gas payment, so no extra gas coin is required
  export extern "iota client pay-all-iota" [
    --input-coins: string     # The input coins to be used for pay recipients, including the gas coin
    --recipient: string       # The recipient address (or its alias if it's an address in the keystore)
    --gas-budget: string      # An optional gas budget for this transaction (in NANOS). If gas budget is not provided, the tool will first perform a dry run to estimate the gas cost, and then it will execute the transaction. Please note that this incurs a small cost in performance due to the additional dry run call
    --dry-run                 # Perform a dry run of the transaction, without executing it
    --serialize-unsigned-transaction # Instead of executing the transaction, serialize the bcs bytes of the unsigned transaction data (TransactionData) using base64 encoding, and print out the string <TX_BYTES>. The string can be used to execute transaction with `iota client execute-signed-tx --tx-bytes <TX_BYTES>`
    --serialize-signed-transaction # Instead of executing the transaction, serialize the bcs bytes of the signed transaction data (SenderSignedData) using base64 encoding, and print out the string <SIGNED_TX_BYTES>. The string can be used to execute transaction with `iota client execute-combined-signed-tx --signed-tx-bytes <SIGNED_TX_BYTES>`
    --emit: string            # Select which fields of the response to display. If not provided, all fields are displayed. The fields are: effects, input, events, object_changes, balance_changes
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

  # Pay IOTA coins to recipients following following specified amounts, with input coins. Length of recipients must be the same as that of amounts. The input coins also include the coin for gas payment, so no extra gas coin is required
  export extern "iota client pay-iota" [
    --input-coins: string     # The input coins to be used for pay recipients, including the gas coin
    --recipients: string      # The recipient addresses, must be of same length as amounts. Aliases of addresses are also accepted as input
    --amounts: string         # The amounts to be paid, following the order of recipients
    --gas-budget: string      # An optional gas budget for this transaction (in NANOS). If gas budget is not provided, the tool will first perform a dry run to estimate the gas cost, and then it will execute the transaction. Please note that this incurs a small cost in performance due to the additional dry run call
    --dry-run                 # Perform a dry run of the transaction, without executing it
    --serialize-unsigned-transaction # Instead of executing the transaction, serialize the bcs bytes of the unsigned transaction data (TransactionData) using base64 encoding, and print out the string <TX_BYTES>. The string can be used to execute transaction with `iota client execute-signed-tx --tx-bytes <TX_BYTES>`
    --serialize-signed-transaction # Instead of executing the transaction, serialize the bcs bytes of the signed transaction data (SenderSignedData) using base64 encoding, and print out the string <SIGNED_TX_BYTES>. The string can be used to execute transaction with `iota client execute-combined-signed-tx --signed-tx-bytes <SIGNED_TX_BYTES>`
    --emit: string            # Select which fields of the response to display. If not provided, all fields are displayed. The fields are: effects, input, events, object_changes, balance_changes
    --json                    # Return command outputs in json format
    --help(-h)                # Print help
  ]

