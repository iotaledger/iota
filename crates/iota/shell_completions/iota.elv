
use builtin;
use str;

set edit:completion:arg-completer[iota] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'iota'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'iota'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand start 'Start a local network in two modes: saving state between re-runs and not saving state between re-runs. Please use (--help) to see the full description'
            cand genesis 'Bootstrap and initialize a new iota network'
            cand genesis-ceremony 'Create an IOTA Genesis Ceremony with multiple remote validators'
            cand keytool 'Iota keystore tool'
            cand console 'Start Iota interactive console'
            cand client 'Client for interacting with the IOTA network'
            cand validator 'A tool for validators and validator candidates'
            cand move 'Tool to build and test Move applications'
            cand bridge-committee-init 'Command to initialize the bridge committee, usually used when running local bridge cluster'
            cand fire-drill 'Tool for Fire Drill'
            cand analyzer 'Invoke Iota''s move-analyzer via CLI'
            cand generate-completions 'generate-completions'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'iota;start'= {
            cand --network.config 'Config directory that will be used to store network config, node db, keystore. `iota genesis -f --with-faucet` generates a genesis config that can be used to start this process. Use with caution as the `-f` flag will overwrite the existing config directory. We can use any config dir that is generated by the `iota genesis`'
            cand --with-faucet 'Start a faucet with default host and port: 0.0.0.0:9123. This flag accepts also a port, a host, or both (e.g., 0.0.0.0:9123). When providing a specific value, please use the = sign between the flag and value: `--with-faucet=6124` or `--with-faucet=0.0.0.0`, or `--with-faucet=0.0.0.0:9123`'
            cand --faucet-amount 'Set the amount of nanos that the faucet will put in an object. Defaults to `200000000000`(200 IOTA)'
            cand --fullnode-rpc-port 'Port to start the Fullnode RPC server on. Default port is 9000'
            cand --epoch-duration-ms 'Set the epoch duration. Can only be used when `--force-regenesis` flag is passed or if there''s no genesis config and one will be auto-generated. When this flag is not set but `--force-regenesis` is set, the epoch duration will be set to 60 seconds'
            cand --local-migration-snapshots 'The path to local migration snapshot files'
            cand --remote-migration-snapshots 'Remotely stored migration snapshots'
            cand --force-regenesis 'A new genesis is created each time this flag is set, and state is not persisted between runs. Only use this flag when you want to start the network from scratch every time you run this command'
            cand --no-full-node 'Start the network without a fullnode'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'iota;genesis'= {
            cand --from-config 'Start genesis with a given config file'
            cand --write-config 'Build a genesis config, write it to the specified path, and exit'
            cand --working-dir 'working-dir'
            cand --epoch-duration-ms 'epoch-duration-ms'
            cand --benchmark-ips 'A list of ip addresses to generate a genesis suitable for benchmarks'
            cand --num-validators 'The number of validators in the network.'
            cand --local-migration-snapshots 'The path to local migration snapshot files'
            cand --remote-migration-snapshots 'Remotely stored migration snapshots'
            cand -f 'Forces overwriting existing configuration'
            cand --force 'Forces overwriting existing configuration'
            cand --with-faucet 'Creates an extra faucet configuration for iota persisted runs.'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;genesis-ceremony'= {
            cand --path 'The directory where the Genesis builder will be stored. Defaults to the current directory'
            cand --protocol-version 'The protocol version to use for this snapshot'
            cand -h 'Print help'
            cand --help 'Print help'
            cand init 'Initialize a Genesis builder which can be configured with validators'
            cand validate-state 'Validate the current state of the Genesis builder'
            cand add-validator 'Add a validator to the Genesis builder'
            cand init-token-distribution-schedule 'Initialize token distribution schedule'
            cand list-validators 'List the current validators in the Genesis builder'
            cand build-unsigned-checkpoint 'Build the Genesis checkpoint'
            cand examine-genesis-checkpoint 'Examine the details of the built Genesis checkpoint'
            cand verify-and-sign 'Verify and sign the built Genesis checkpoint'
            cand finalize 'Create the Genesis blob file from the current configuration'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'iota;genesis-ceremony;init'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;genesis-ceremony;validate-state'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;genesis-ceremony;add-validator'= {
            cand --name 'The name of the validator'
            cand --authority-key-file 'The path to the BLS12381 authority key file for the validator'
            cand --protocol-key-file 'The path to the Ed25519 network key file for the consensus protocol'
            cand --account-key-file 'The path to the Ed25519 network key file for the account'
            cand --network-key-file 'The path to the Ed25519 network key file'
            cand --network-address 'The network address. This must be a TCP address in ASCII format'
            cand --p2p-address 'The peer-to-peer address. This must be a UDP address in ASCII format'
            cand --primary-address 'The primary address. This must be a UDP address in ASCII format'
            cand --description 'An optional description of the validator'
            cand --image-url 'An optional URL pointing to an image for the validator'
            cand --project-url 'An optional URL pointing to the validator webpage'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;genesis-ceremony;init-token-distribution-schedule'= {
            cand --token-allocations-path 'The path to the csv file with the token allocations'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;genesis-ceremony;list-validators'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;genesis-ceremony;build-unsigned-checkpoint'= {
            cand --local-migration-snapshots 'Define paths to local migration snapshots.'
            cand --remote-migration-snapshots 'Remote migration snapshots.'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;genesis-ceremony;examine-genesis-checkpoint'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;genesis-ceremony;verify-and-sign'= {
            cand --key-file 'The path to a key file which will be used to sign the checkpoint'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;genesis-ceremony;finalize'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;genesis-ceremony;help'= {
            cand init 'Initialize a Genesis builder which can be configured with validators'
            cand validate-state 'Validate the current state of the Genesis builder'
            cand add-validator 'Add a validator to the Genesis builder'
            cand init-token-distribution-schedule 'Initialize token distribution schedule'
            cand list-validators 'List the current validators in the Genesis builder'
            cand build-unsigned-checkpoint 'Build the Genesis checkpoint'
            cand examine-genesis-checkpoint 'Examine the details of the built Genesis checkpoint'
            cand verify-and-sign 'Verify and sign the built Genesis checkpoint'
            cand finalize 'Create the Genesis blob file from the current configuration'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'iota;genesis-ceremony;help;init'= {
        }
        &'iota;genesis-ceremony;help;validate-state'= {
        }
        &'iota;genesis-ceremony;help;add-validator'= {
        }
        &'iota;genesis-ceremony;help;init-token-distribution-schedule'= {
        }
        &'iota;genesis-ceremony;help;list-validators'= {
        }
        &'iota;genesis-ceremony;help;build-unsigned-checkpoint'= {
        }
        &'iota;genesis-ceremony;help;examine-genesis-checkpoint'= {
        }
        &'iota;genesis-ceremony;help;verify-and-sign'= {
        }
        &'iota;genesis-ceremony;help;finalize'= {
        }
        &'iota;genesis-ceremony;help;help'= {
        }
        &'iota;keytool'= {
            cand --keystore-path 'keystore-path'
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
            cand update-alias 'Update an old alias to a new one. If a new alias is not provided, a random one will be generated'
            cand convert 'Convert private key in Hex or Base64 to new format (Bech32 encoded 33 byte flag || private key starting with "iotaprivkey"). Hex private key format import and export are both deprecated in Iota Wallet and Iota CLI Keystore. Use `iota keytool import` if you wish to import a key to Iota Keystore'
            cand decode-or-verify-tx 'Given a Base64 encoded transaction bytes, decode its components. If a signature is provided, verify the signature against the transaction and output the result'
            cand decode-multi-sig 'Given a Base64 encoded MultiSig signature, decode its components. If tx_bytes is passed in, verify the multisig'
            cand generate 'Generate a new keypair with key scheme flag {ed25519 | secp256k1 | secp256r1} with optional derivation path, default to m/44''/4218''/0''/0''/0'' for ed25519 or m/54''/4218''/0''/0/0 for secp256k1 or m/74''/4218''/0''/0/0 for secp256r1. Word length can be { word12 | word15 | word18 | word21 | word24} default to word12 if not specified'
            cand import 'Add a new key to Iota CLI Keystore using either the input mnemonic phrase, a Bech32 encoded 33-byte `flag || privkey` starting with "iotaprivkey" or a seed, the key scheme flag {ed25519 | secp256k1 | secp256r1} and an optional derivation path, default to m/44''/4218''/0''/0''/0'' for ed25519 or m/54''/4218''/0''/0/0 for secp256k1 or m/74''/4218''/0''/0/0 for secp256r1. Supports mnemonic phrase of word length 12, 15, 18, 21, 24. Set an alias for the key with the --alias flag. If no alias is provided, the tool will automatically generate one'
            cand export 'Output the private key of the given key identity in Iota CLI Keystore as Bech32 encoded string starting with `iotaprivkey`'
            cand list 'List all keys by its Iota address, Base64 encoded public key, key scheme name in iota.keystore'
            cand multi-sig-address 'To MultiSig Iota Address. Pass in a list of all public keys `flag || pk` in Base64. See `keytool list` for example public keys'
            cand multi-sig-combine-partial-sig 'Provides a list of participating signatures (`flag || sig || pk` encoded in Base64), threshold, a list of all public keys and a list of their weights that define the MultiSig address. Returns a valid MultiSig signature and its sender address. The result can be used as signature field for `iota client execute-signed-tx`. The sum of weights of all signatures must be >= the threshold'
            cand show 'Read the content at the provided file path. The accepted format can be [enum IotaKeyPair] (Base64 encoded of 33-byte `flag || privkey`) or `type AuthorityKeyPair` (Base64 encoded `privkey`). It prints its Base64 encoded public key and the key scheme flag'
            cand sign 'Create signature using the private key for for the given address (or its alias) in iota keystore. Any signature commits to a [struct IntentMessage] consisting of the Base64 encoded of the BCS serialized transaction bytes itself and its intent. If intent is absent, default will be used'
            cand sign-kms 'Creates a signature by leveraging AWS KMS. Pass in a key-id to leverage Amazon KMS to sign a message and the base64 pubkey. Generate PubKey from pem using iotaledger/base64pemkey Any signature commits to a [struct IntentMessage] consisting of the Base64 encoded of the BCS serialized transaction bytes itself and its intent. If intent is absent, default will be used'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'iota;keytool;update-alias'= {
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;keytool;convert'= {
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;keytool;decode-or-verify-tx'= {
            cand --tx-bytes 'tx-bytes'
            cand --sig 'sig'
            cand --cur-epoch 'cur-epoch'
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;keytool;decode-multi-sig'= {
            cand --multisig 'multisig'
            cand --tx-bytes 'tx-bytes'
            cand --cur-epoch 'cur-epoch'
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;keytool;generate'= {
            cand --json 'Return command outputs in json format'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'iota;keytool;import'= {
            cand --alias 'Sets an alias for this address. The alias must start with a letter and can contain only letters, digits, hyphens (-), or underscores (_)'
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;keytool;export'= {
            cand --key-identity 'key-identity'
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;keytool;list'= {
            cand -s 'Sort by alias'
            cand --sort-by-alias 'Sort by alias'
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;keytool;multi-sig-address'= {
            cand --threshold 'threshold'
            cand --pks 'pks'
            cand --weights 'weights'
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;keytool;multi-sig-combine-partial-sig'= {
            cand --sigs 'sigs'
            cand --pks 'pks'
            cand --weights 'weights'
            cand --threshold 'threshold'
            cand --json 'Return command outputs in json format'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'iota;keytool;show'= {
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;keytool;sign'= {
            cand --address 'address'
            cand --data 'data'
            cand --intent 'intent'
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;keytool;sign-kms'= {
            cand --data 'data'
            cand --keyid 'keyid'
            cand --intent 'intent'
            cand --base64pk 'base64pk'
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;keytool;help'= {
            cand update-alias 'Update an old alias to a new one. If a new alias is not provided, a random one will be generated'
            cand convert 'Convert private key in Hex or Base64 to new format (Bech32 encoded 33 byte flag || private key starting with "iotaprivkey"). Hex private key format import and export are both deprecated in Iota Wallet and Iota CLI Keystore. Use `iota keytool import` if you wish to import a key to Iota Keystore'
            cand decode-or-verify-tx 'Given a Base64 encoded transaction bytes, decode its components. If a signature is provided, verify the signature against the transaction and output the result'
            cand decode-multi-sig 'Given a Base64 encoded MultiSig signature, decode its components. If tx_bytes is passed in, verify the multisig'
            cand generate 'Generate a new keypair with key scheme flag {ed25519 | secp256k1 | secp256r1} with optional derivation path, default to m/44''/4218''/0''/0''/0'' for ed25519 or m/54''/4218''/0''/0/0 for secp256k1 or m/74''/4218''/0''/0/0 for secp256r1. Word length can be { word12 | word15 | word18 | word21 | word24} default to word12 if not specified'
            cand import 'Add a new key to Iota CLI Keystore using either the input mnemonic phrase, a Bech32 encoded 33-byte `flag || privkey` starting with "iotaprivkey" or a seed, the key scheme flag {ed25519 | secp256k1 | secp256r1} and an optional derivation path, default to m/44''/4218''/0''/0''/0'' for ed25519 or m/54''/4218''/0''/0/0 for secp256k1 or m/74''/4218''/0''/0/0 for secp256r1. Supports mnemonic phrase of word length 12, 15, 18, 21, 24. Set an alias for the key with the --alias flag. If no alias is provided, the tool will automatically generate one'
            cand export 'Output the private key of the given key identity in Iota CLI Keystore as Bech32 encoded string starting with `iotaprivkey`'
            cand list 'List all keys by its Iota address, Base64 encoded public key, key scheme name in iota.keystore'
            cand multi-sig-address 'To MultiSig Iota Address. Pass in a list of all public keys `flag || pk` in Base64. See `keytool list` for example public keys'
            cand multi-sig-combine-partial-sig 'Provides a list of participating signatures (`flag || sig || pk` encoded in Base64), threshold, a list of all public keys and a list of their weights that define the MultiSig address. Returns a valid MultiSig signature and its sender address. The result can be used as signature field for `iota client execute-signed-tx`. The sum of weights of all signatures must be >= the threshold'
            cand show 'Read the content at the provided file path. The accepted format can be [enum IotaKeyPair] (Base64 encoded of 33-byte `flag || privkey`) or `type AuthorityKeyPair` (Base64 encoded `privkey`). It prints its Base64 encoded public key and the key scheme flag'
            cand sign 'Create signature using the private key for for the given address (or its alias) in iota keystore. Any signature commits to a [struct IntentMessage] consisting of the Base64 encoded of the BCS serialized transaction bytes itself and its intent. If intent is absent, default will be used'
            cand sign-kms 'Creates a signature by leveraging AWS KMS. Pass in a key-id to leverage Amazon KMS to sign a message and the base64 pubkey. Generate PubKey from pem using iotaledger/base64pemkey Any signature commits to a [struct IntentMessage] consisting of the Base64 encoded of the BCS serialized transaction bytes itself and its intent. If intent is absent, default will be used'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'iota;keytool;help;update-alias'= {
        }
        &'iota;keytool;help;convert'= {
        }
        &'iota;keytool;help;decode-or-verify-tx'= {
        }
        &'iota;keytool;help;decode-multi-sig'= {
        }
        &'iota;keytool;help;generate'= {
        }
        &'iota;keytool;help;import'= {
        }
        &'iota;keytool;help;export'= {
        }
        &'iota;keytool;help;list'= {
        }
        &'iota;keytool;help;multi-sig-address'= {
        }
        &'iota;keytool;help;multi-sig-combine-partial-sig'= {
        }
        &'iota;keytool;help;show'= {
        }
        &'iota;keytool;help;sign'= {
        }
        &'iota;keytool;help;sign-kms'= {
        }
        &'iota;keytool;help;help'= {
        }
        &'iota;console'= {
            cand --client.config 'Sets the file storing the state of our user accounts (an empty one will be created if missing)'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;client'= {
            cand --client.config 'Sets the file storing the state of our user accounts (an empty one will be created if missing)'
            cand --json 'Return command outputs in json format'
            cand -y 'y'
            cand --yes 'yes'
            cand -h 'Print help'
            cand --help 'Print help'
            cand active-address 'Default address used for commands when none specified'
            cand active-env 'Default environment used for commands when none specified'
            cand addresses 'Obtain the Addresses managed by the client'
            cand balance 'List the coin balance of an address'
            cand call 'Call Move function'
            cand chain-identifier 'Query the chain identifier from the rpc endpoint'
            cand dynamic-field 'Query a dynamic field by its address'
            cand envs 'List all IOTA environments'
            cand execute-signed-tx 'Execute a Signed Transaction. This is useful when the user prefers to sign elsewhere and use this command to execute'
            cand execute-combined-signed-tx 'Execute a combined serialized SenderSignedData string'
            cand faucet 'Request gas coin from faucet. By default, it will use the active address and the active network'
            cand gas 'Obtain all gas objects owned by the address. An address'' alias can be used instead of the address'
            cand merge-coin 'Merge two coin objects into one coin'
            cand new-address 'Generate new address and keypair with keypair scheme flag {ed25519 | secp256k1 | secp256r1} with optional derivation path, default to m/44''/4218''/0''/0''/0'' for ed25519 or m/54''/4218''/0''/0/0 for secp256k1 or m/74''/4218''/0''/0/0 for secp256r1. Word length can be { word12 | word15 | word18 | word21 | word24} default to word12 if not specified'
            cand new-env 'Add new IOTA environment'
            cand object 'Get object info'
            cand objects 'Obtain all objects owned by the address. It also accepts an address by its alias'
            cand pay 'Pay coins to recipients following specified amounts, with input coins. Length of recipients must be the same as that of amounts'
            cand pay-all-iota 'Pay all residual IOTA coins to the recipient with input coins, after deducting the gas cost. The input coins also include the coin for gas payment, so no extra gas coin is required'
            cand pay-iota 'Pay IOTA coins to recipients following following specified amounts, with input coins. Length of recipients must be the same as that of amounts. The input coins also include the coin for gas payment, so no extra gas coin is required'
            cand ptb 'Run a PTB from the provided args'
            cand publish 'Publish Move modules'
            cand split-coin 'Split a coin object into multiple coins'
            cand switch 'Switch active address and network(e.g., devnet, local rpc server)'
            cand tx-block 'Get a transaction block with the effects, events and object changes of its execution'
            cand transfer 'Transfer object'
            cand transfer-iota 'Transfer IOTA, and pay gas with the same IOTA coin object. If amount is specified, only the amount is transferred; otherwise the entire object is transferred'
            cand upgrade 'Upgrade Move modules'
            cand verify-bytecode-meter 'Run the bytecode verifier on the package'
            cand verify-source 'Verify local Move packages against on-chain packages, and optionally their dependencies'
            cand profile-transaction 'Profile the gas usage of a transaction. Unless an output filepath is not specified, outputs a file `gas_profile_{tx_digest}_{unix_timestamp}.json` which can be opened in a flamegraph tool such as speedscope'
            cand replay-transaction 'Replay a given transaction to view transaction effects. Set environment variable MOVE_VM_STEP=1 to debug'
            cand replay-batch 'Replay transactions listed in a file'
            cand replay-checkpoint 'Replay all transactions in a range of checkpoints'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'iota;client;active-address'= {
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;client;active-env'= {
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;client;addresses'= {
            cand -s 'Sort by alias instead of address'
            cand --sort-by-alias 'Sort by alias instead of address'
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;client;balance'= {
            cand --coin-type 'Show balance for the specified coin (e.g., 0x2::iota::IOTA). All coins will be shown if none is passed'
            cand --with-coins 'Show a list with each coin''s object ID and balance'
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;client;call'= {
            cand --package 'Object ID of the package, which contains the module'
            cand --module 'The name of the module in the package'
            cand --function 'Function name in module'
            cand --type-args 'Type arguments to the generic function being called. All must be specified, or the call will fail'
            cand --args 'Simplified ordered args like in the function syntax ObjectIDs, Addresses must be hex strings'
            cand --gas 'ID of the gas object for gas payment. If not provided, a gas object with at least gas_budget value will be selected'
            cand --gas-budget 'An optional gas budget for this transaction (in NANOS). If gas budget is not provided, the tool will first perform a dry run to estimate the gas cost, and then it will execute the transaction. Please note that this incurs a small cost in performance due to the additional dry run call'
            cand --emit 'Select which fields of the response to display. If not provided, all fields are displayed. The fields are: effects, input, events, object_changes, balance_changes'
            cand --dry-run 'Perform a dry run of the transaction, without executing it'
            cand --serialize-unsigned-transaction 'Instead of executing the transaction, serialize the bcs bytes of the unsigned transaction data (TransactionData) using base64 encoding, and print out the string <TX_BYTES>. The string can be used to execute transaction with `iota client execute-signed-tx --tx-bytes <TX_BYTES>`'
            cand --serialize-signed-transaction 'Instead of executing the transaction, serialize the bcs bytes of the signed transaction data (SenderSignedData) using base64 encoding, and print out the string <SIGNED_TX_BYTES>. The string can be used to execute transaction with `iota client execute-combined-signed-tx --signed-tx-bytes <SIGNED_TX_BYTES>`'
            cand --json 'Return command outputs in json format'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'iota;client;chain-identifier'= {
