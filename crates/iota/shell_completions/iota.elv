        &'iota;help;validator'= {
            cand make-validator-info 'Generate a `validator.info` file and 4 key pair files (account, network, authority, protocol)'
            cand become-candidate 'Submit an on-chain transaction to become a validator candidate. The parameter is the file path to the `validator.info` generated by `MakeValidatorInfo`'
            cand join-committee 'Once you collect enough staking amount, run this command to become a pending validator. A pending validator will become active and join the committee starting from next epoch'
            cand leave-committee 'Leave committee starting with the next epoch'
            cand display-metadata 'Display metadata about the validator'
            cand update-metadata 'Update the validator metadata'
            cand update-gas-price 'Update gas price that is used to calculate Reference Gas Price'
            cand report-validator 'Report or un-report a validator as bad or non-performant'
            cand serialize-payload-pop 'Serialize the payload that is used to generate Proof of Possession. This is useful to take the payload offline for an Authority protocol keypair to sign'
            cand display-gas-price-update-raw-txn 'Print out the serialized data of a transaction that sets the gas price quote for a validator'
            cand register-bridge-committee 'IOTA native bridge committee member registration'
            cand update-bridge-committee-node-url 'Update IOTA native bridge committee node url'
            cand list 'Get a list of the validators in the network. Use the `display-metadata` command to see the complete data for a validator'
        }
