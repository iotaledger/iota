            "uid": "prometheus"
          },
          "expr": "rate(total_transaction_effects[30s])",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Useful TPS (per validator)",
      "type": "timeseries"
    },
