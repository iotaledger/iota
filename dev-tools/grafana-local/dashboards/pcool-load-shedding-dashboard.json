  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Post-consensus arrival rate of user transactions per validator: sum of rate(consensus_handler_processed{class=~\"owned_user_transaction|shared_user_transaction\"}[30s]). Under white-flag flow stress traffic does NOT go through the V1 handle_transaction path, so `total_transaction_orders` stays near zero \u2014 the consensus-handler classifier is the authoritative arrival count. If this is flat at zero, the stress harness isn't producing traffic that reaches consensus \u2014 check runs/<ts>/stress-stdout.log, docker compose ps, and the fullnode RPC port.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host) (rate(consensus_handler_processed{class=~\"owned_user_transaction|shared_user_transaction|owned_certificate|shared_certificate\"}[30s]))",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Arrival TPS (per validator)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Useful throughput: rate of transaction effects emitted per validator. With execution_delay_ms=100 and Semaphore::new(1) the per-validator ceiling is ~10 TPS. Steady-state useful TPS at the ceiling is the expected end state during a successful stress run; the interesting question is what arrivals look like relative to it.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "ops"
        }
      },
      "gridPos": {
