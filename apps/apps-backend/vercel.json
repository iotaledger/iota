{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "outputDirectory": ".",
    "buildCommand": "turbo run build",
    "rewrites": [
      {
        "source": "/(.*)",
        "destination": "/api"
      }
    ],
    "installCommand": "pnpm install",
    "devCommand": "pnpm run dev"
  }