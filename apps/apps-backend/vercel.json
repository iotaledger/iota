{
    "version": 2,
    "builds": [
        {
            "src": "dist/apps-backend/src/main.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": ["dist/**/*"]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "dist/apps-backend/src/main.js"
        }
    ]
}
