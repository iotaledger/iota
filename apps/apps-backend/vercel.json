{
    "version": 2,
    "buildCommand": "pnpm turbo --filter apps-backend build",
    "builds": [
        {
            "src": "dist/apps-backend/src/vercel-func.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "dist/apps-backend/src/vercel-func.js"
        }
    ]
}
