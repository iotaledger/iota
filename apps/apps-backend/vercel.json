{
    "version": 2,
    "builds": [
        {
            "src": "apps-backend/src/main.ts",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "dist/**/*"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "dist/apps-backend/src/main.js"
        }
    ]
}