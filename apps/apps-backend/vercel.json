{
    "version": 2,
    "builds": [
        {
            "src": "apps-backend/src/main.js",
            "use": "@vercel/node"
        }
    ],
    "functions": {
        "apps-backend/src/main.js": {
            "includeFiles": "**/*"
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "apps-backend/src/main.js"
        }
    ]
}