{
    "$schema": "https://turbo.build/schema.json",
    "extends": "turbo",
    "tasks": {
        "build": {
            "cache": false,
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "vercel-build": {
            "cache": false,
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "clean": {
            "cache": false, 
            "outputs": []
        }
    }
}
