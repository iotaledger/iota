<mxfile host="drawio" type="device">
  <diagram id="account-table-fill" name="Filling the tables">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="p2_0" />
        <mxCell id="p2_1" parent="p2_0" />
        <mxCell id="p2_title" value="Account discoverability: how two transactions with the same key fill the tables" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="p2_1">
          <mxGeometry x="40" y="15" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2_legend" value="&lt;b&gt;K&lt;/b&gt; = one Ed25519 public key &amp;nbsp;·&amp;nbsp; &lt;b&gt;h(K)&lt;/b&gt; = key_id = blake2b256(0x00 || K) &amp;nbsp;·&amp;nbsp; &lt;b&gt;A1&lt;/b&gt; = fresh object ID &amp;nbsp;·&amp;nbsp; &lt;b&gt;A2&lt;/b&gt; = the address derived from K &amp;nbsp;·&amp;nbsp; both transactions in epoch 3" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="p2_1">
          <mxGeometry x="40" y="45" width="1320" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tx1" value="&lt;b&gt;tx 101&lt;/b&gt; (blue) · sender: anyone&lt;br&gt;builtin_auth_builder_v1(K), then build_v1" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=4;strokeColor=#000000;fontSize=12;collapsible=0;align=left;spacingLeft=10;startSize=46;fillColor=#DAE8FC;swimlaneFillColor=#FFFFFF;" vertex="1" parent="p2_1">
          <mxGeometry x="40" y="80" width="420" height="310" as="geometry" />
        </mxCell>
        <mxCell id="tx2" value="&lt;b&gt;tx 102&lt;/b&gt; (orange) · ClaimAccount, sender: A2&lt;br&gt;claim_account_v1(K): claim_builder, then build_v1" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=4;strokeColor=#000000;fontSize=12;collapsible=0;align=left;spacingLeft=10;startSize=46;fillColor=#FFE6CC;swimlaneFillColor=#FFFFFF;" vertex="1" parent="p2_1">
          <mxGeometry x="40" y="440" width="420" height="310" as="geometry" />
        </mxCell>
        <mxCell id="tx1_ev1" value="&lt;b&gt;1. PublicKeyAttached&lt;/b&gt;&lt;br&gt;account_id: A1&lt;br&gt;public_key: K (scheme 0, Ed25519)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;arcSize=10;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#DAE8FC;" vertex="1" parent="tx1">
          <mxGeometry x="15" y="65" width="390" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tx1_ev2" value="&lt;b&gt;2. SmartAccountCreated&lt;/b&gt;&lt;br&gt;account_id: A1, public_key: some(K)&lt;br&gt;immutable: false" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;arcSize=10;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#DAE8FC;" vertex="1" parent="tx1">
          <mxGeometry x="15" y="145" width="390" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tx1_ev3" value="&lt;b&gt;3. MutableAccountCreated&amp;lt;SmartAccount&amp;gt;&lt;/b&gt;&lt;br&gt;account_id: A1&lt;br&gt;authenticator: 0x2::builtin_authenticator_functions::&lt;br&gt;ed25519_authenticator_function_ref_v1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;arcSize=10;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#DAE8FC;" vertex="1" parent="tx1">
          <mxGeometry x="15" y="225" width="390" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tx2_ev1" value="&lt;b&gt;1. PublicKeyAttached&lt;/b&gt;&lt;br&gt;account_id: A2&lt;br&gt;public_key: K (scheme 0, Ed25519)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;arcSize=10;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#FFE6CC;" vertex="1" parent="tx2">
          <mxGeometry x="15" y="65" width="390" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tx2_ev2" value="&lt;b&gt;2. SmartAccountCreated&lt;/b&gt;&lt;br&gt;account_id: A2, public_key: some(K)&lt;br&gt;immutable: false" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;arcSize=10;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#FFE6CC;" vertex="1" parent="tx2">
          <mxGeometry x="15" y="145" width="390" height="70" as="geometry" />
        </mxCell>
