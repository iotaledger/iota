        <mxCell id="p2_note" value="&lt;b&gt;Why no link from SmartAccountCreated:&lt;/b&gt; its public_key is not used for links. The PublicKeyAttached of the same transaction already gives the (h(K), account) link. SmartAccountCreated only records that the account is a framework SmartAccount." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#000000;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="p2_1">
          <mxGeometry x="620" y="730" width="740" height="50" as="geometry" />
