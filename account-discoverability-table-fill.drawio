        <mxCell id="t_accounts" value="&lt;b&gt;smart_accounts&lt;/b&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=4;strokeColor=#000000;fontSize=12;collapsible=0;align=left;spacingLeft=10;startSize=30;fillColor=#F5F5F5;swimlaneFillColor=#F5F5F5;" vertex="1" parent="p2_1">
